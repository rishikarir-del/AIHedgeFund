# ---- Database (milestone 3) ----
DATABASE_URL=postgres://arfos:arfos@localhost:5432/arfos

# ---- Redis / BullMQ (milestone 3) ----
REDIS_URL=redis://localhost:6379

# ---- Object storage, S3-compatible (milestone 7) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arfos-artefacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Auth, Clerk (milestone 4) ----
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=arf-os

# ---- Model providers (milestone 12) ----
# Never send TradingView exports or protected holdout data to a model.
ANTHROPIC_API_KEY=

NODE_ENV=development
LOG_LEVEL=info
