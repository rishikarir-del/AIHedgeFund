{
  "name": "@arf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev": "node --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@arf/auth": "workspace:*",
    "@arf/contracts": "workspace:*",
    "@arf/db": "workspace:*",
    "@arf/metrics": "workspace:*",
    "@arf/pine": "workspace:*",
    "@arf/workflow": "workspace:*",
    "@clerk/backend": "^2.33.6",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3",
    "@arf/event-bus": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
