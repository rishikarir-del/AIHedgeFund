{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arf-os.local/schemas/backtest-run-result.schema.json",
  "title": "backtest-run-result",
  "description": "Backtest result, source-discriminated (see ADR 0002)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "strategyVersionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "strategyVersionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "timeframe": {
          "type": "string",
          "minLength": 1
        },
        "initialCapital": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "segments": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "enum": [
                  "IN_SAMPLE",
                  "VALIDATION",
                  "OUT_OF_SAMPLE",
                  "FINAL_HOLDOUT",
                  "FORWARD"
                ]
              },
              "from": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "to": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "scope",
              "from",
              "to"
            ]
          }
        },
        "parameterSet": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "number",
              "boolean"
            ]
          }
        },
        "costModel": {
          "type": "object",
          "properties": {
            "commissionType": {
              "type": "string",
              "enum": [
                "percent",
                "cash_per_order",
                "cash_per_contract"
              ]
            },
            "commissionValue": {
              "type": "number",
              "minimum": 0
            },
            "slippageTicks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "commissionType",
            "commissionValue",
            "slippageTicks"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "strategyVersionId",
        "symbol",
        "timeframe",
        "initialCapital",
        "segments",
        "parameterSet",
        "costModel"
      ]
    },
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "tradingview_csv"
            },
            "uploadChecksum": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reportType": {
              "type": "string",
              "enum": [
                "performance_summary",
                "list_of_trades"
              ]
            }
          },
          "required": [
            "source",
            "uploadChecksum",
            "reportType"
          ]
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "mcp_engine"
            },
            "engine": {
              "type": "string",
              "minLength": 1
            },
            "engineVersion": {
              "type": "string",
              "minLength": 1
            },
            "externalResultId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source",
            "engine",
            "engineVersion",
            "externalResultId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "local_runner"
            },
            "runnerName": {
              "type": "string",
              "minLength": 1
            },
            "runnerVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source",
            "runnerName",
            "runnerVersion"
          ]
        }
      ]
    },
    "codeHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "datasetHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "direction": {
            "type": "string",
            "enum": [
              "long",
              "short"
            ]
          },
          "entryTime": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "exitTime": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "entryPrice": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          },
          "exitPrice": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "quantity": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          },
          "profit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sequence",
          "direction",
          "entryTime",
          "exitTime",
          "entryPrice",
          "exitPrice",
          "quantity",
          "profit"
        ]
      }
    },
    "equity": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "barTime": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "equity": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          }
        },
        "required": [
          "barTime",
          "equity"
        ]
      }
    },
    "reportedMetrics": {
      "type": "object",
      "properties": {
        "netProfit": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "netProfitPct": {
          "type": "number"
        },
        "maxDrawdown": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "maxDrawdownPct": {
          "type": "number"
        },
        "maxRunup": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "maxRunupPct": {
          "type": "number"
        },
        "totalTrades": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "profitFactor": {
          "type": "number"
        },
        "warnings": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "strategyVersionId",
    "plan",
    "identity",
    "codeHash",
    "manifestHash",
    "datasetHash",
    "trades",
    "equity",
    "reportedMetrics",
    "createdAt"
  ]
}
