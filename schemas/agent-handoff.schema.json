{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arf-os.local/schemas/agent-handoff.schema.json",
  "title": "agent-handoff",
  "description": "Typed contract for agent-to-agent handoffs (spec section 8)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "handoffId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "campaignId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "strategyId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "strategyVersionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fromAgent": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "CHIEF_RESEARCH_ORCHESTRATOR",
            "IDEA_SCOUT",
            "INDICATOR_RESEARCHER",
            "STRATEGY_ARCHITECT",
            "PINE_ENGINEER",
            "BACKTEST_ENGINEER",
            "ROBUSTNESS_VALIDATOR",
            "FORWARD_TEST_OPERATOR",
            "STRATEGY_JUDGE",
            "DATA_INTEGRITY_ANALYST",
            "PORTFOLIO_RESEARCHER"
          ]
        },
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "promptVersion": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "role",
        "agentId",
        "promptVersion"
      ]
    },
    "toRole": {
      "type": "string",
      "enum": [
        "CHIEF_RESEARCH_ORCHESTRATOR",
        "IDEA_SCOUT",
        "INDICATOR_RESEARCHER",
        "STRATEGY_ARCHITECT",
        "PINE_ENGINEER",
        "BACKTEST_ENGINEER",
        "ROBUSTNESS_VALIDATOR",
        "FORWARD_TEST_OPERATOR",
        "STRATEGY_JUDGE",
        "DATA_INTEGRITY_ANALYST",
        "PORTFOLIO_RESEARCHER"
      ]
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskFlags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "INFO",
              "WARN",
              "CRITICAL"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "severity",
          "detail"
        ]
      }
    },
    "artefactIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "requestedAction": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "handoffId",
    "campaignId",
    "strategyId",
    "strategyVersionId",
    "fromAgent",
    "toRole",
    "taskId",
    "status",
    "summary",
    "assumptions",
    "unknowns",
    "riskFlags",
    "artefactIds",
    "evidenceIds",
    "requestedAction",
    "createdAt"
  ]
}
