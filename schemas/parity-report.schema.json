{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arf-os.local/schemas/parity-report.schema.json",
  "title": "parity-report",
  "description": "Reported-versus-calculated comparison (spec section 15.3)",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "INSUFFICIENT_DATA"
      ]
    },
    "firstDivergence": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "reported": {
              "type": "string"
            },
            "calculated": {
              "type": "string"
            }
          },
          "required": [
            "field",
            "reported",
            "calculated"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "checkedFields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "verdict",
    "firstDivergence",
    "checkedFields",
    "createdAt"
  ]
}
